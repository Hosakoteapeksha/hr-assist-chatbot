# Streamlit Cloud: paste these lines into  App > Settings > Secrets  (fill in your values)
GOOGLE_API_KEY = "paste-your-gemini-api-key-here"
GEMINI_MODEL = "gemini-2.5-flash"

# Your own HR admin login (the demo admin is switched off when you set this)
ADMIN_EMAIL = "your.admin.email@gmail.com"
ADMIN_PASSWORD = "choose-a-strong-password"
DEFAULT_EMPLOYEE_PASSWORD = "Welcome@123"
SHOW_DEMO_LOGINS = "0"
ALLOW_SIGNUP = "1"
# ALLOWED_EMAIL_DOMAINS = "mycompany.com"

SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USER = "your.gmail@gmail.com"
SMTP_PASSWORD = "your 16 letter app password"
HR_EMAIL = "hr.inbox@gmail.com"
APP_URL = "https://hr-assist-apeksha.streamlit.app"

# Optional - keeps users and requests permanently (free at neon.tech):
# DATABASE_URL = "postgresql://user:password@host/dbname?sslmode=require"
