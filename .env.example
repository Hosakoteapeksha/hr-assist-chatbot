# Copy this file to .env and fill in your values. Never commit .env to GitHub.

# --- AI (required) ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Login ---
# HR admin login (created automatically). Change the password!
ADMIN_EMAIL=hr.admin@company.com
ADMIN_PASSWORD=Admin@123
# Starting password for employees in data/employees.csv
DEFAULT_EMPLOYEE_PASSWORD=Welcome@123
# 1 = show demo accounts on the login page, 0 = hide
SHOW_DEMO_LOGINS=1

# --- Email to HR (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Inbox that receives every new request (comma-separate several)
HR_EMAIL=
APP_URL=http://localhost:8501

# --- Database (optional) ---
# Empty = SQLite file in data/. For permanent storage online, paste a PostgreSQL URL (e.g. from neon.tech)
DATABASE_URL=
